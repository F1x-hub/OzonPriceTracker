{
  "manifest_version": 3,
  "name": "Ozon Price Tracker",
  "version": "1.0.2",
  "description": "Мониторинг цен на товары Ozon.ru и Wildberries",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://www.wildberries.ru/*",
    "https://seller.ozon.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wildberries.ru/catalog/*/detail.aspx"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://seller.ozon.ru/app/reviews*",
        "https://seller.ozon.ru/app/products/edit/*"
      ],
      "js": [
        "seller_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}